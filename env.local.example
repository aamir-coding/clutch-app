# ==========================================
# CLUTCH ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# ------------------------------------------
# Group 1: Firebase Client Config (Public)
# ------------------------------------------
# Obtained from Firebase Console -> Project Settings -> General -> Your Apps (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
# Obtained from Firebase Console -> Project Settings -> General -> Project ID
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
# Obtained from Firebase Console -> Project Settings -> General -> Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
# Obtained from Firebase Console -> Project Settings -> General -> Storage Bucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app-id.appspot.com"
# Obtained from Firebase Console -> Project Settings -> General -> Messaging Sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
# Obtained from Firebase Console -> Project Settings -> General -> App ID
NEXT_PUBLIC_FIREBASE_APP_ID="1:your-messaging-sender-id:web:your-app-id"
# Obtained from Firebase Console -> Project Settings -> General -> Measurement ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-your-measurement-id"
# Generated in Firebase Console -> Project Settings -> Cloud Messaging -> Web Configuration -> Web Push Certificates (VAPID Key)
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-fcm-vapid-key"

# ------------------------------------------
# Group 2: Google OAuth Configuration
# ------------------------------------------
# Generated in Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID (Web Application)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# Generated alongside GOOGLE_CLIENT_ID in the Google Cloud Console Credentials page
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# The fully qualified redirect URI that maps to your API route for OAuth callback (e.g. https://yourdomain.com/api/auth/callback)
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# ------------------------------------------
# Group 3: Gemini AI API Key
# ------------------------------------------
# Obtained from Google AI Studio -> Get API Key (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------
# Group 4: Firebase Admin SDK Configuration
# ------------------------------------------
# Generated in Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key.
# Paste the entire downloaded JSON payload here as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "your-app-id", "private_key_id": "...", "private_key": "...", "client_email": "..."}'

# ------------------------------------------
# Group 5: Core App Configuration
# ------------------------------------------
# Any randomized high-entropy 32-character string used to sign session cookies and JSON Web Tokens securely
NEXTAUTH_SECRET="your-randomized-32-char-nextauth-secret"
# The canonical public URL where the application is hosted (e.g., http://localhost:3000 during local development)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
